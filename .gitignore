# ============================================================
# .gitignore — SIMS (Shipyard Inventory Management System)
# ============================================================

# ── Dependencies ──
node_modules/
.pnp
.pnp.js

# ── Build Output ──
dist/
dist-ssr/
build/
*.local

# ── Logs ──
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Environment Variables ──
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ── OS Files ──
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# ── Editor / IDE ──
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo
*~

# ── Testing ──
coverage/
*.lcov

# ── Misc ──
.cache/
.temp/
.tmp/
*.tsbuildinfo
